{
  "name": "revit-web",
  "version": "0.1.0",
  "private": true,
  "description": "A browser-based building information modeling (BIM) editor built from scratch.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:ai-manual": "node server/manualTest.mjs",
    "e2e": "node e2e/slice1.e2e.mjs",
    "e2e:ai": "node e2e/slice6-ai.e2e.mjs",
    "e2e:all": "npm run e2e && node e2e/slice2.e2e.mjs && node e2e/slice3.e2e.mjs && node e2e/slice4.e2e.mjs && node e2e/slice5.e2e.mjs && node e2e/slice6-ai.e2e.mjs && npm run e2e:studio",
    "typecheck": "tsc --noEmit",
    "e2e:studio": "node e2e/studio.e2e.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.56.0",
    "radix-ui": "^1.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.170.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "puppeteer-core": "^25.13.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  }
}
